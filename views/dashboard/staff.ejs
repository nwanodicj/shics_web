<%# AUTO-COMMENT: File Overview - views/dashboard/staff.ejs | Purpose: View template: server-rendered UI markup and bindings. %>
<div class="dashboard-layout">
  <%- include("../partials/dashboard-profile-banner", {
    name: user.name,
    role: user.role,
    subtitle: "Manage your classroom materials and keep your account details up to date.",
    profileImage: user.profile_picture,
    actions: [
      { href: "/dashboard", label: "Back to Dashboard" }
    ]
  }) %>

  <div class="dashboard-content">
    <div class="dashboard-sidebar-shell">
      <%- include("../partials/staff-sidebar") %>
    </div>

    <div class="dashboard-main">
    <section id="overview" class="dashboard-section <%= activeSection === 'overview' ? '' : 'dashboard-hidden' %>">
      <h2>My Information</h2>
      <table class="dashboard-table-full dashboard-table-collapse">
        <tr>
          <td class="dashboard-table-cell"><strong>Name</strong></td>
          <td class="dashboard-table-cell"><%= user.name || "N/A" %></td>
        </tr>
        <tr>
          <td class="dashboard-table-cell"><strong>Email</strong></td>
          <td class="dashboard-table-cell"><%= user.email || "N/A" %></td>
        </tr>
        <tr>
          <td class="dashboard-table-cell"><strong>Phone</strong></td>
          <td class="dashboard-table-cell"><%= user.phone || "Not provided" %></td>
        </tr>
        <tr>
          <td class="dashboard-table-cell"><strong>Address</strong></td>
          <td class="dashboard-table-cell"><%= user.address || "Not provided" %></td>
        </tr>
      </table>
    </section>

<!-- ============================================
     SECTION 1: UPLOAD LESSON
     ============================================ -->
<section id="lessons" class="dashboard-section <%= activeSection === 'lessons' ? '' : 'dashboard-hidden' %>">
  <h2>Upload Lesson Material</h2>
  <form method="post" action="/staff/upload-lesson" enctype="multipart/form-data">
    <div class="dashboard-field-lg">
      <label for="title">Lesson Title</label>
      <input type="text" id="title" name="title" placeholder="e.g., Introduction to Biology" required>
    </div>

    <div class="dashboard-field-lg">
      <label for="subject">Subject</label>
      <input type="text" id="subject" name="subject" placeholder="e.g., Biology" required>
    </div>

    <div class="dashboard-field-lg">
      <label for="class">Class</label>
      <input type="text" id="class" name="class" placeholder="e.g., SS2A" required>
    </div>

    <div class="dashboard-field-lg">
      <label for="term">Term</label>
      <input type="text" id="term" name="term" placeholder="e.g., First Term" required>
    </div>

    <div class="dashboard-field-lg">
      <label for="type">Material Type</label>
      <select id="type" name="type" required>
        <option value="">-- Select --</option>
        <option value="lesson_note">Lesson Note</option>
        <option value="lesson_plan">Lesson Plan</option>
      </select>
    </div>

    <div class="dashboard-field-lg">
      <label for="file">File</label>
      <input type="file" id="file" name="file" required>
    </div>

    <button type="submit">Upload Lesson</button>
  </form>
</section>

<section id="approved-notes" class="dashboard-section <%= activeSection === 'approved-notes' ? '' : 'dashboard-hidden' %>">
  <h2>Approved Lesson Notes</h2>
  <% if (approvedNotes && approvedNotes.length > 0) { %>
    <table border="1" cellpadding="6" cellspacing="0" class="dashboard-table-full">
      <thead>
        <tr>
          <th>Title</th>
          <th>Subject</th>
          <th>Class</th>
          <th>Term</th>
          <th>Uploaded</th>
        </tr>
      </thead>
      <tbody>
        <% approvedNotes.forEach(note => { %>
          <tr>
            <td><%= note.title || 'Untitled' %></td>
            <td><%= note.subject || 'N/A' %></td>
            <td><%= note.class || 'N/A' %></td>
            <td><%= note.term || 'N/A' %></td>
            <td><%= new Date(note.created_at).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No approved lesson notes found yet.</p>
  <% } %>
</section>

<section id="approved-plans" class="dashboard-section <%= activeSection === 'approved-plans' ? '' : 'dashboard-hidden' %>">
  <h2>Approved Lesson Plans</h2>
  <% if (approvedPlans && approvedPlans.length > 0) { %>
    <table border="1" cellpadding="6" cellspacing="0" class="dashboard-table-full">
      <thead>
        <tr>
          <th>Title</th>
          <th>Subject</th>
          <th>Class</th>
          <th>Term</th>
          <th>Uploaded</th>
        </tr>
      </thead>
      <tbody>
        <% approvedPlans.forEach(plan => { %>
          <tr>
            <td><%= plan.title || 'Untitled' %></td>
            <td><%= plan.subject || 'N/A' %></td>
            <td><%= plan.class || 'N/A' %></td>
            <td><%= plan.term || 'N/A' %></td>
            <td><%= new Date(plan.created_at).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No approved lesson plans found yet.</p>
  <% } %>
</section>

<!-- ============================================
     SECTION 2: ATTENDANCE CHECK-IN/OUT
     ============================================ -->
<section id="attendance" class="dashboard-section <%= activeSection === 'attendance' ? '' : 'dashboard-hidden' %>">
  <h2>Attendance</h2>
  <p>Check in or out for today.</p>
  <button onclick="staffCheckIn()" class="dashboard-btn-gap">Check In</button>
  <button onclick="staffCheckOut()" class="dashboard-btn-gap">Check Out</button>
</section>

<section id="announcements" class="dashboard-section <%= activeSection === 'announcements' ? '' : 'dashboard-hidden' %>">
  <h2>Announcements</h2>
  <% if (announcements && announcements.length > 0) { %>
    <ul class="dashboard-list">
      <% announcements.forEach(item => { %>
        <li class="dashboard-list-item-md">
          <strong><%= item.title || 'Announcement' %></strong>
          <p class="dashboard-paragraph-tight"><%= item.message %></p>
          <small class="dashboard-muted"><%= item.created_at ? new Date(item.created_at).toLocaleString() : '' %></small>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No announcements available yet.</p>
  <% } %>
</section>

<!-- ============================================
     SECTION 3: NOTIFICATIONS (READ-ONLY)
     ============================================ -->
<section id="notifications" class="dashboard-section <%= activeSection === 'notifications' ? '' : 'dashboard-hidden' %>">
  <h2>Notifications <% if (notificationCount > 0) { %><small class="dashboard-muted">(<%= notificationCount %> unread)</small><% } %></h2>
  <% if (notifications && notifications.length > 0) { %>
    <ul class="dashboard-list">
      <% notifications.forEach(note => { %>
        <li class="dashboard-list-item-sm">
          <div><%= note.message %></div>
          <small class="dashboard-muted">
            <%= note.created_at ? new Date(note.created_at).toLocaleString() : '' %>
          </small>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No notifications available.</p>
  <% } %>
</section>

<section id="profile-form" class="dashboard-section <%= activeSection === 'profile' ? '' : 'dashboard-hidden' %>">
  <h2>Complete Your Profile</h2>
  <p>Add your remaining bio details and profile picture here.</p>
  <form action="/staff/update-profile" method="post" enctype="multipart/form-data">
    <div class="dashboard-field">
      <label for="phone">Phone Number</label><br>
      <input type="text" id="phone" name="phone" value="<%= user.phone || "" %>">
    </div>

    <div class="dashboard-field">
      <label for="address">Home Address</label><br>
      <textarea id="address" name="address" rows="3"><%= user.address || "" %></textarea>
    </div>

    <div class="dashboard-field">
      <label for="date_of_birth">Date of Birth</label><br>
      <input type="date" id="date_of_birth" name="date_of_birth" value="<%= user.date_of_birth || "" %>">
    </div>

    <div class="dashboard-field">
      <label for="guardian_name">Guardian Name</label><br>
      <input type="text" id="guardian_name" name="guardian_name" value="<%= user.guardian_name || "" %>">
    </div>

    <div class="dashboard-field">
      <label for="bio">Short Bio</label><br>
      <textarea id="bio" name="bio" rows="4"><%= user.bio || "" %></textarea>
    </div>

    <div class="dashboard-field">
      <label for="profilePicture">Profile Picture</label><br>
      <input type="file" id="profilePicture" name="profilePicture" accept="image/*">
    </div>

    <% if (user.profile_picture) { %>
      <div class="dashboard-field">
        <img src="<%= user.profile_picture %>" alt="Current profile" class="dashboard-avatar">
      </div>
    <% } %>

    <button type="submit">Save Profile</button>
  </form>
</section>
    </div>
  </div>
</div>

<script>
async function staffCheckIn() {
  try {
    const res = await fetch("/attendance/check-in", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ staffId: "<%= user.id %>" })
    })
    const data = await res.json()
    alert(data.message || "Check-in completed")
  } catch (err) {
    console.error(err)
    alert("Check-in failed")
  }
}

async function staffCheckOut() {
  try {
    const res = await fetch("/attendance/check-out", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ staffId: "<%= user.id %>" })
    })
    const data = await res.json()
    alert(data.message || "Check-out completed")
  } catch (err) {
    console.error(err)
    alert("Check-out failed")
  }
}

</script>