<style>
  .dashboard-layout {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .dashboard-content {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .dashboard-main {
    flex: 1;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .dashboard-content {
      flex-direction: column;
    }
  }
</style>

<div class="dashboard-layout">
  <%- include("../partials/dashboard-profile-banner", {
    name: user.name,
    role: user.role,
    subtitle: "Manage your classroom materials and keep your account details up to date.",
    profileImage: user.profile_picture,
    actions: [
      { href: "/dashboard", label: "Back to Dashboard" }
    ]
  }) %>

  <div class="dashboard-content">
    <div class="dashboard-sidebar-shell">
      <%- include("../partials/staff-sidebar") %>
    </div>

    <div class="dashboard-main">
    <section id="overview" style="display: <%= activeSection === 'overview' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
      <h2>My Information</h2>
      <table style="width: 100%; border-collapse: collapse;">
        <tr>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><strong>Name</strong></td>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><%= user.name || "N/A" %></td>
        </tr>
        <tr>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><strong>Email</strong></td>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><%= user.email || "N/A" %></td>
        </tr>
        <tr>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><strong>Phone</strong></td>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><%= user.phone || "Not provided" %></td>
        </tr>
        <tr>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><strong>Address</strong></td>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><%= user.address || "Not provided" %></td>
        </tr>
      </table>
    </section>

<!-- ============================================
     SECTION 1: UPLOAD LESSON
     ============================================ -->
<section id="lessons" style="display: <%= activeSection === 'lessons' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
  <h2>Upload Lesson Material</h2>
  <form method="post" action="/staff/upload-lesson" enctype="multipart/form-data">
    <div style="margin-bottom: 1rem;">
      <label for="title">Lesson Title</label>
      <input type="text" id="title" name="title" placeholder="e.g., Introduction to Biology" required>
    </div>

    <div style="margin-bottom: 1rem;">
      <label for="subject">Subject</label>
      <input type="text" id="subject" name="subject" placeholder="e.g., Biology" required>
    </div>

    <div style="margin-bottom: 1rem;">
      <label for="class">Class</label>
      <input type="text" id="class" name="class" placeholder="e.g., SS2A" required>
    </div>

    <div style="margin-bottom: 1rem;">
      <label for="term">Term</label>
      <input type="text" id="term" name="term" placeholder="e.g., First Term" required>
    </div>

    <div style="margin-bottom: 1rem;">
      <label for="type">Material Type</label>
      <select id="type" name="type" required>
        <option value="">-- Select --</option>
        <option value="lesson_note">Lesson Note</option>
        <option value="lesson_plan">Lesson Plan</option>
      </select>
    </div>

    <div style="margin-bottom: 1rem;">
      <label for="file">File</label>
      <input type="file" id="file" name="file" required>
    </div>

    <button type="submit">Upload Lesson</button>
  </form>
</section>

<section id="approved-notes" style="display: <%= activeSection === 'approved-notes' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
  <h2>Approved Lesson Notes</h2>
  <% if (approvedNotes && approvedNotes.length > 0) { %>
    <table border="1" cellpadding="6" cellspacing="0" style="width: 100%;">
      <thead>
        <tr>
          <th>Title</th>
          <th>Subject</th>
          <th>Class</th>
          <th>Term</th>
          <th>Uploaded</th>
        </tr>
      </thead>
      <tbody>
        <% approvedNotes.forEach(note => { %>
          <tr>
            <td><%= note.title || 'Untitled' %></td>
            <td><%= note.subject || 'N/A' %></td>
            <td><%= note.class || 'N/A' %></td>
            <td><%= note.term || 'N/A' %></td>
            <td><%= new Date(note.created_at).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No approved lesson notes found yet.</p>
  <% } %>
</section>

<section id="approved-plans" style="display: <%= activeSection === 'approved-plans' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
  <h2>Approved Lesson Plans</h2>
  <% if (approvedPlans && approvedPlans.length > 0) { %>
    <table border="1" cellpadding="6" cellspacing="0" style="width: 100%;">
      <thead>
        <tr>
          <th>Title</th>
          <th>Subject</th>
          <th>Class</th>
          <th>Term</th>
          <th>Uploaded</th>
        </tr>
      </thead>
      <tbody>
        <% approvedPlans.forEach(plan => { %>
          <tr>
            <td><%= plan.title || 'Untitled' %></td>
            <td><%= plan.subject || 'N/A' %></td>
            <td><%= plan.class || 'N/A' %></td>
            <td><%= plan.term || 'N/A' %></td>
            <td><%= new Date(plan.created_at).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No approved lesson plans found yet.</p>
  <% } %>
</section>

<!-- ============================================
     SECTION 2: ATTENDANCE CHECK-IN/OUT
     ============================================ -->
<section id="attendance" style="display: <%= activeSection === 'attendance' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
  <h2>Attendance</h2>
  <p>Check in or out for today.</p>
  <button onclick="staffCheckIn()" style="margin-right: 0.5rem;">Check In</button>
  <button onclick="staffCheckOut()" style="margin-right: 0.5rem;">Check Out</button>
</section>

<!-- ============================================
     SECTION 3: NOTIFICATIONS (READ-ONLY)
     ============================================ -->
<section id="notifications" style="display: <%= activeSection === 'notifications' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
  <h2>Notifications</h2>
  <% if (notifications && notifications.length > 0) { %>
    <ul style="margin: 0; padding-left: 1.1rem;">
      <% notifications.forEach(note => { %>
        <li style="margin-bottom: 0.75rem;">
          <div><%= note.message %></div>
          <small style="color: #64748b;">
            <%= note.created_at ? new Date(note.created_at).toLocaleString() : '' %>
          </small>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No notifications available.</p>
  <% } %>
</section>

<section id="profile-form" style="display: <%= activeSection === 'profile' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
  <h2>Complete Your Profile</h2>
  <p>Add your remaining bio details and profile picture here.</p>
  <form action="/staff/update-profile" method="post" enctype="multipart/form-data">
    <div style="margin-bottom: 0.75rem;">
      <label for="phone">Phone Number</label><br>
      <input type="text" id="phone" name="phone" value="<%= user.phone || "" %>">
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="address">Home Address</label><br>
      <textarea id="address" name="address" rows="3"><%= user.address || "" %></textarea>
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="date_of_birth">Date of Birth</label><br>
      <input type="date" id="date_of_birth" name="date_of_birth" value="<%= user.date_of_birth || "" %>">
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="guardian_name">Guardian Name</label><br>
      <input type="text" id="guardian_name" name="guardian_name" value="<%= user.guardian_name || "" %>">
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="bio">Short Bio</label><br>
      <textarea id="bio" name="bio" rows="4"><%= user.bio || "" %></textarea>
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="profilePicture">Profile Picture</label><br>
      <input type="file" id="profilePicture" name="profilePicture" accept="image/*">
    </div>

    <% if (user.profile_picture) { %>
      <div style="margin-bottom: 0.75rem;">
        <img src="<%= user.profile_picture %>" alt="Current profile" style="max-width: 120px; border-radius: 50%;">
      </div>
    <% } %>

    <button type="submit">Save Profile</button>
  </form>
</section>
    </div>
  </div>
</div>

<script>
async function staffCheckIn() {
  try {
    const res = await fetch("/attendance/check-in", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ staffId: "<%= user.id %>" })
    })
    const data = await res.json()
    alert(data.message || "Check-in completed")
  } catch (err) {
    console.error(err)
    alert("Check-in failed")
  }
}

async function staffCheckOut() {
  try {
    const res = await fetch("/attendance/check-out", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ staffId: "<%= user.id %>" })
    })
    const data = await res.json()
    alert(data.message || "Check-out completed")
  } catch (err) {
    console.error(err)
    alert("Check-out failed")
  }
}

</script>