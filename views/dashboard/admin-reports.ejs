<%# AUTO-COMMENT: File Overview - views/dashboard/admin-reports.ejs | Purpose: View template: server-rendered UI markup and bindings. %>
<div class="admin-page-shell">
  <%- include("../partials/admin-sidebar") %>
  <div class="admin-page-main">
    <h1 class="admin-page-title">Reports</h1>

    <section class="admin-card">
      <h2>Report Summary</h2>
      <p>Total Results: <strong><%= reportTotals.total_results || 0 %></strong></p>
      <p>Overall Average Score: <strong><%= reportTotals.average_score || '0.00' %></strong></p>
    </section>

    <section class="admin-card">
      <h2>Student Term Reports</h2>
      <% if (reportSummaries && reportSummaries.length > 0) { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Student</th>
              <th>Term</th>
              <th>Tests</th>
              <th>Average</th>
              <th>Lowest</th>
              <th>Highest</th>
            </tr>
          </thead>
          <tbody>
            <% reportSummaries.forEach(report => { %>
              <tr>
                <td><%= report.student_name %></td>
                <td><%= report.term %></td>
                <td><%= report.result_count %></td>
                <td><%= report.average_score %></td>
                <td><%= report.min_score %></td>
                <td><%= report.max_score %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="admin-empty-state">No reporting data is available yet.</p>
      <% } %>
    </section>
  </div>
</div>
