<%# AUTO-COMMENT: File Overview - views/dashboard/student.ejs | Purpose: View template: server-rendered UI markup and bindings. %>
<div class="dashboard-layout">
  <%- include("../partials/dashboard-profile-banner", {
    name: user.name,
    role: user.role,
    subtitle: "Manage your academic progress and keep your profile current.",
    profileImage: student && student.profile_picture ? student.profile_picture : user.profile_picture,
    actions: [
      { href: "/dashboard", label: "Back to Dashboard" },
      { href: "/student/download-report", label: "Download Report Card" }
    ]
  }) %>

  <div class="dashboard-content">
    <div class="dashboard-sidebar-shell">
      <%- include("../partials/student-sidebar") %>
    </div>

    <div class="dashboard-main">
    <section id="overview" class="dashboard-section <%= activeSection === 'overview' ? '' : 'dashboard-hidden' %>">
      <h2>My Information</h2>
      <% if (student) { %>
        <table class="dashboard-table-full dashboard-table-collapse">
          <tr>
            <td class="dashboard-table-cell"><strong>Name</strong></td>
            <td class="dashboard-table-cell"><%= student.name || "N/A" %></td>
          </tr>
          <tr>
            <td class="dashboard-table-cell"><strong>Email</strong></td>
            <td class="dashboard-table-cell"><%= student.email || "N/A" %></td>
          </tr>
          <tr>
            <td class="dashboard-table-cell"><strong>Phone</strong></td>
            <td class="dashboard-table-cell"><%= student.phone || "Not provided" %></td>
          </tr>
          <tr>
            <td class="dashboard-table-cell"><strong>Address</strong></td>
            <td class="dashboard-table-cell"><%= student.address || "Not provided" %></td>
          </tr>
        </table>
      <% } else { %>
        <p>Student information not available.</p>
      <% } %>
    </section>

    <section id="results" class="dashboard-section <%= activeSection === 'results' ? '' : 'dashboard-hidden' %>">
      <h2>My Published Report Cards</h2>
      <% if (results && results.length > 0) { %>
        <table border="1" cellpadding="6" cellspacing="0" class="dashboard-table-full">
          <thead>
            <tr>
              <th>Term</th>
              <th>Average</th>
              <th>Remark</th>
              <th>Subjects</th>
              <th>Download</th>
            </tr>
          </thead>
          <tbody>
            <% results.forEach(reportCard => { %>
              <tr>
                <td><%= reportCard.publication.term || "N/A" %></td>
                <td><%= Number(reportCard.publication.average_score).toFixed(2) %></td>
                <td><%= reportCard.publication.remark || "N/A" %></td>
                <td>
                  <% reportCard.subjects.forEach(subject => { %>
                    <div><%= subject.subject %>: <%= subject.score %> (<%= subject.grade %>)</div>
                  <% }) %>
                </td>
                <td><a href="/student/download-report?term=<%= encodeURIComponent(reportCard.publication.term) %>" target="_blank" rel="noopener">Download</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p>No published report cards available yet.</p>
      <% } %>
    </section>

    <section id="lessons" class="dashboard-section <%= activeSection === 'lessons' ? '' : 'dashboard-hidden' %>">
      <h2>Lesson Notes</h2>
      <% if (lessons && lessons.length > 0) { %>
        <table border="1" cellpadding="6" cellspacing="0" class="dashboard-table-full">
          <thead>
            <tr>
              <th>Title</th>
              <th>Subject</th>
              <th>Class</th>
              <th>File</th>
            </tr>
          </thead>
          <tbody>
            <% lessons.forEach(lesson => { %>
              <tr>
                <td><%= lesson.title || "Untitled" %></td>
                <td><%= lesson.subject || "N/A" %></td>
                <td><%= lesson.class || "N/A" %></td>
                <td>
                  <% if (lesson.file_url) { %>
                    <a href="<%= lesson.file_url %>" target="_blank" rel="noopener">Download</a>
                  <% } else { %>
                    —
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p>No lesson notes available yet.</p>
      <% } %>
    </section>

    <section id="announcements" class="dashboard-section <%= activeSection === 'announcements' ? '' : 'dashboard-hidden' %>">
      <h2>Announcements</h2>
      <% if (announcements && announcements.length > 0) { %>
        <table border="1" cellpadding="6" cellspacing="0" class="dashboard-table-full">
          <thead>
            <tr>
              <th>Title</th>
              <th>Message</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% announcements.forEach(item => { %>
              <tr>
                <td><%= item.title || "Announcement" %></td>
                <td><%= item.message %></td>
                <td><%= item.created_at ? new Date(item.created_at).toLocaleString() : "N/A" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p>No announcements available yet.</p>
      <% } %>
    </section>

    <section id="notifications" class="dashboard-section <%= activeSection === 'notifications' ? '' : 'dashboard-hidden' %>">
      <h2>Notifications <% if (notificationCount > 0) { %><small class="dashboard-muted">(<%= notificationCount %> unread)</small><% } %></h2>
      <% if (notifications && notifications.length > 0) { %>
        <table border="1" cellpadding="6" cellspacing="0" class="dashboard-table-full">
          <thead>
            <tr>
              <th>Message</th>
              <th>Received</th>
            </tr>
          </thead>
          <tbody>
            <% notifications.forEach(note => { %>
              <tr>
                <td><%= note.message %></td>
                <td><%= note.created_at ? new Date(note.created_at).toLocaleString() : "N/A" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p>No notifications available yet.</p>
      <% } %>
    </section>

    <section id="profile-form" class="dashboard-section <%= activeSection === 'profile' ? '' : 'dashboard-hidden' %>">
      <h2>Complete Your Profile</h2>
      <p>Add the rest of your bio details and a profile picture here.</p>
      <form action="/student/update-profile" method="post" enctype="multipart/form-data">
        <div class="dashboard-field">
          <label for="phone">Phone Number</label><br>
          <input type="text" id="phone" name="phone" value="<%= student.phone || "" %>">
        </div>

        <div class="dashboard-field">
          <label for="address">Home Address</label><br>
          <textarea id="address" name="address" rows="3"><%= student.address || "" %></textarea>
        </div>

        <div class="dashboard-field">
          <label for="date_of_birth">Date of Birth</label><br>
          <input type="date" id="date_of_birth" name="date_of_birth" value="<%= student.date_of_birth || "" %>">
        </div>

        <div class="dashboard-field">
          <label for="guardian_name">Guardian Name</label><br>
          <input type="text" id="guardian_name" name="guardian_name" value="<%= student.guardian_name || "" %>">
        </div>

        <div class="dashboard-field">
          <label for="bio">Short Bio</label><br>
          <textarea id="bio" name="bio" rows="4"><%= student.bio || "" %></textarea>
        </div>

        <div class="dashboard-field">
          <label for="profilePicture">Profile Picture</label><br>
          <input type="file" id="profilePicture" name="profilePicture" accept="image/*">
        </div>

        <% if (student.profile_picture) { %>
          <div class="dashboard-field">
            <img src="<%= student.profile_picture %>" alt="Current profile" class="dashboard-avatar">
          </div>
        <% } %>

        <button type="submit">Save Profile</button>
      </form>
    </section>
    </div>
  </div>
</div>