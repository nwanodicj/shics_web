<%# AUTO-COMMENT: File Overview - views/dashboard/admin-announcements.ejs | Purpose: View template: server-rendered UI markup and bindings. %>
<div class="admin-page-shell">
  <%- include("../partials/admin-sidebar") %>
  <div class="admin-page-main">
    <h1 class="admin-page-title">Announcements</h1>

    <section class="admin-card">
      <h2>Create Announcement</h2>
      <form action="/admin/create-announcement" method="POST" class="admin-form-grid">
        <input type="text" name="title" placeholder="Title" required class="admin-form-control">
        <textarea name="message" rows="4" placeholder="Message" required class="admin-form-control"></textarea>
        <label class="admin-label">
          Target Role
          <select name="role_target" class="admin-form-control">
            <option value="all">All</option>
            <option value="admin">Admin</option>
            <option value="staff">Staff</option>
            <option value="student">Student</option>
            <option value="parent">Parent</option>
          </select>
        </label>
        <button type="submit" class="admin-submit-btn">Publish Announcement</button>
      </form>
    </section>

    <section class="admin-card">
      <h2>Recent Announcements</h2>
      <% if (announcements && announcements.length > 0) { %>
        <ul class="admin-announcement-list">
          <% announcements.forEach(announcement => { %>
            <li class="admin-announcement-item">
              <strong><%= announcement.title %></strong>
              <p><%= announcement.message %></p>
              <small>Target: <%= announcement.role_target || 'all' %> • <%= new Date(announcement.created_at).toLocaleString() %></small>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="admin-empty-state">No announcements have been published yet.</p>
      <% } %>
    </section>
  </div>
</div>
