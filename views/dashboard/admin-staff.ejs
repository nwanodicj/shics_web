<div class="admin-page-shell">
  <%- include("../partials/admin-sidebar") %>
  <div class="admin-page-main">
    <h1 class="admin-page-title">Staff Management</h1>

    <section class="admin-card">
      <h2>Add New Staff</h2>
      <form id="addStaffForm">
        <div class="admin-form-grid">
          <input type="text" id="name" name="name" placeholder="Staff Name" required class="admin-form-control">
          <input type="email" id="email" name="email" placeholder="Staff Email" required class="admin-form-control">
          <input type="password" id="password" name="password" placeholder="Password" required class="admin-form-control">
          <label class="admin-label">
            Class
            <select id="class_id" name="class_id" required class="admin-form-control">
              <option value="">Select class</option>
              <% classes.forEach(clazz => { %>
                <option value="<%= clazz.id %>"><%= clazz.name %></option>
              <% }) %>
            </select>
          </label>
          <label class="admin-label">
            Subject
            <select id="subject_id" name="subject_id" required class="admin-form-control">
              <option value="">Select subject</option>
              <% subjects.forEach(subject => { %>
                <option value="<%= subject.id %>"><%= subject.name %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="admin-submit-btn">Add Staff</button>
        </div>
      </form>
      <div id="addStaffMessage" class="admin-message"></div>
    </section>

    <section class="admin-card">
      <h2>Registered Staff</h2>
      <% if (staff && staff.length > 0) { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Created</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% staff.forEach(member => { %>
                <tr>
                  <td><%= member.name %></td>
                  <td><%= member.email %></td>
                  <td><%= new Date(member.created_at).toLocaleDateString() %></td>
                  <td>
                    <form action="/admin/delete-staff/<%= member.id %>" method="GET" onsubmit="return confirm('Remove this staff member?');">
                      <button type="submit" class="admin-remove-btn">Remove</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="admin-empty-state">No staff members are registered yet.</p>
      <% } %>
    </section>

    <section class="admin-card">
      <h2>Staff Assignments</h2>
      <% if (assignments && assignments.length > 0) { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Staff</th>
                <th>Class</th>
                <th>Subject</th>
                <th>Assigned</th>
              </tr>
            </thead>
            <tbody>
              <% assignments.forEach(assignment => { %>
                <tr>
                  <td><%= assignment.staff_name %></td>
                  <td><%= assignment.class_name %></td>
                  <td><%= assignment.subject_name %></td>
                  <td><%= assignment.created_at ? new Date(assignment.created_at).toLocaleDateString() : '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="admin-empty-state">No class/subject assignments have been made yet.</p>
      <% } %>
    </section>
  </div>
</div>

<script>
  document.getElementById("addStaffForm").addEventListener("submit", async (e) => {
    e.preventDefault()
    const name = document.getElementById("name").value
    const email = document.getElementById("email").value
    const password = document.getElementById("password").value
    const messageDiv = document.getElementById("addStaffMessage")

    try {
      const class_id = document.getElementById("class_id").value
      const subject_id = document.getElementById("subject_id").value

      const res = await fetch("/admin/add-staff", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, password, class_id, subject_id })
      })

      const data = await res.json()
      messageDiv.style.display = "block"

      if (res.ok) {
        messageDiv.style.color = "#166534"
        messageDiv.textContent = "✓ Staff added successfully. Refresh the page to view the updated list."
        document.getElementById("addStaffForm").reset()
      } else {
        messageDiv.style.color = "#991b1b"
        messageDiv.textContent = data.error || "Error adding staff"
      }
    } catch (err) {
      messageDiv.style.display = "block"
      messageDiv.style.color = "#991b1b"
      messageDiv.textContent = "Network error while adding staff"
    }
  })
</script>
