<style>
  .dashboard-layout {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .dashboard-content {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .dashboard-main {
    flex: 1;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .dashboard-content {
      flex-direction: column;
    }
  }
</style>

<div class="dashboard-layout">
  <%- include("../partials/dashboard-profile-banner", {
    name: user.name,
    role: user.role,
    subtitle: "Track your child’s progress and keep your contact details current.",
    profileImage: user.profile_picture,
    actions: [
      { href: "/dashboard", label: "Back to Dashboard" }
    ]
  }) %>

  <div class="dashboard-content">
    <div class="dashboard-sidebar-shell">
      <%- include("../partials/parent-sidebar") %>
    </div>

    <div class="dashboard-main">
    <section id="overview" style="display: <%= activeSection === 'overview' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
      <h2>My Information</h2>
      <table style="width: 100%; border-collapse: collapse;">
        <tr>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><strong>Name</strong></td>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><%= user.name || "N/A" %></td>
        </tr>
        <tr>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><strong>Email</strong></td>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><%= user.email || "N/A" %></td>
        </tr>
        <tr>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><strong>Phone</strong></td>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><%= user.phone || "Not provided" %></td>
        </tr>
        <tr>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><strong>Address</strong></td>
          <td style="border: 1px solid #ddd; padding: 0.5rem;"><%= user.address || "Not provided" %></td>
        </tr>
      </table>
    </section>

<!-- ============================================
     SECTION 1: MY CHILDREN (READ-ONLY)
     ============================================ -->
<section id="children" style="display: <%= activeSection === 'children' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
  <h2>My Children</h2>
  <% if (children && children.length > 0) { %>
    <table border="1" cellpadding="6" cellspacing="0" style="width: 100%;">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% children.forEach(child => { %>
          <tr>
            <td><%= child.name || "N/A" %></td>
            <td><%= child.email || "N/A" %></td>
            <td><%= child.role || "N/A" %></td>
            <td>
              <a href="/parent/download-report/<%= child.id %>" target="_blank" rel="noopener">Report Card</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No children linked to your account yet. Please contact the school administration.</p>
  <% } %>
</section>

<!-- ============================================
     SECTION 2: CHILDREN'S PUBLISHED REPORT CARDS
     ============================================ -->
<section id="results" style="display: <%= activeSection === 'results' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
  <h2>Children's Published Report Cards</h2>
  <% if (results && results.length > 0) { %>
    <table border="1" cellpadding="6" cellspacing="0" style="width: 100%;">
      <thead>
        <tr>
          <th>Child Name</th>
          <th>Term</th>
          <th>Average</th>
          <th>Remark</th>
          <th>Subjects</th>
          <th>Download</th>
        </tr>
      </thead>
      <tbody>
        <% results.forEach(reportCard => { %>
          <tr>
            <td><%= reportCard.student.name || "N/A" %></td>
            <td><%= reportCard.publication.term || "N/A" %></td>
            <td><%= Number(reportCard.publication.average_score).toFixed(2) %></td>
            <td><%= reportCard.publication.remark || "N/A" %></td>
            <td>
              <% reportCard.subjects.forEach(subject => { %>
                <div><%= subject.subject %>: <%= subject.score %> (<%= subject.grade %>)</div>
              <% }) %>
            </td>
            <td><a href="/parent/download-report/<%= reportCard.student.id %>?term=<%= encodeURIComponent(reportCard.publication.term) %>" target="_blank" rel="noopener">Download</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No published report cards available yet.</p>
  <% } %>
</section>

    <section id="announcements" style="display: <%= activeSection === 'announcements' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
      <h2>Announcements</h2>
      <% if (announcements && announcements.length > 0) { %>
        <table border="1" cellpadding="6" cellspacing="0" style="width: 100%;">
          <thead>
            <tr>
              <th>Title</th>
              <th>Message</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% announcements.forEach(item => { %>
              <tr>
                <td><%= item.title || "Announcement" %></td>
                <td><%= item.message %></td>
                <td><%= item.created_at ? new Date(item.created_at).toLocaleString() : "N/A" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p>No announcements available yet.</p>
      <% } %>
    </section>

    <section id="notifications" style="display: <%= activeSection === 'notifications' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
      <h2>Notifications <% if (notificationCount > 0) { %><small style="color: #64748b;">(<%= notificationCount %> unread)</small><% } %></h2>
      <% if (notifications && notifications.length > 0) { %>
        <table border="1" cellpadding="6" cellspacing="0" style="width: 100%;">
          <thead>
            <tr>
              <th>Message</th>
              <th>Received</th>
            </tr>
          </thead>
          <tbody>
            <% notifications.forEach(note => { %>
              <tr>
                <td><%= note.message %></td>
                <td><%= note.created_at ? new Date(note.created_at).toLocaleString() : "N/A" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p>No notifications available yet.</p>
      <% } %>
    </section>

<section id="profile-form" style="display: <%= activeSection === 'profile' ? 'block' : 'none' %>; margin-bottom: 2rem; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;">
  <h2>Complete Your Profile</h2>
  <p>Add your remaining bio details and profile picture here.</p>
  <form action="/parent/update-profile" method="post" enctype="multipart/form-data">
    <div style="margin-bottom: 0.75rem;">
      <label for="phone">Phone Number</label><br>
      <input type="text" id="phone" name="phone" value="<%= user.phone || "" %>">
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="address">Home Address</label><br>
      <textarea id="address" name="address" rows="3"><%= user.address || "" %></textarea>
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="date_of_birth">Date of Birth</label><br>
      <input type="date" id="date_of_birth" name="date_of_birth" value="<%= user.date_of_birth || "" %>">
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="guardian_name">Guardian Name</label><br>
      <input type="text" id="guardian_name" name="guardian_name" value="<%= user.guardian_name || "" %>">
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="bio">Short Bio</label><br>
      <textarea id="bio" name="bio" rows="4"><%= user.bio || "" %></textarea>
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="profilePicture">Profile Picture</label><br>
      <input type="file" id="profilePicture" name="profilePicture" accept="image/*">
    </div>

    <% if (user.profile_picture) { %>
      <div style="margin-bottom: 0.75rem;">
        <img src="<%= user.profile_picture %>" alt="Current profile" style="max-width: 120px; border-radius: 50%;">
      </div>
    <% } %>

    <button type="submit">Save Profile</button>
  </form>
</section>
    </div>
  </div>
</div>