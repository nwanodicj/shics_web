<style>
  .admin-dashboard-layout {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .admin-dashboard-main {
    flex: 1;
    min-width: 320px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .admin-dashboard-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .admin-dashboard-header h1 {
    margin: 0;
    font-size: 2rem;
  }

  .admin-dashboard-header p {
    margin: 0.25rem 0 0;
    color: #475569;
  }

  .admin-dashboard-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .admin-dashboard-actions a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
  }

  .admin-card {
    padding: 1.25rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
  }

  .admin-card h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .admin-chart-attendance-grid {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(280px, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .admin-dashboard-layout,
    .admin-chart-attendance-grid {
      grid-template-columns: 1fr;
      flex-direction: column;
    }
  }
</style>

<div class="admin-dashboard-layout">
  <%- include("../partials/admin-sidebar") %>
  <div class="admin-dashboard-main">
    <div class="admin-dashboard-header admin-card">
      <div>
        <h1>Admin Dashboard</h1>
        <p>Welcome <%= user.name %></p>
        <p>Role: <%= user.role %></p>
      </div>
      <div class="admin-dashboard-actions">
        <a href="/admin/dashboard">Refresh dashboard</a>
        <a href="/dashboard">Go to main dashboard</a>
      </div>
    </div>

    <section class="admin-card">
      <h2>Add Student</h2>
  <form id="addStudentForm">
    <input type="text" id="name" name="name" placeholder="Student Name" required>
    <input type="email" id="email" name="email" placeholder="Student Email" required>
    <input type="password" id="password" name="password" placeholder="Password" required>
    <button type="submit">Add Student</button>
  </form>
  <div id="addStudentMessage" style="margin-top: 1rem; display: none;"></div>
</section>

<script>
document.getElementById("addStudentForm").addEventListener("submit", async (e) => {
  e.preventDefault()
  
  const name = document.getElementById("name").value
  const email = document.getElementById("email").value
  const password = document.getElementById("password").value
  const messageDiv = document.getElementById("addStudentMessage")
  
  try {
    const res = await fetch("/admin/add-student", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ name, email, password })
    })
    
    const data = await res.json()
    
    if (res.ok) {
      messageDiv.style.display = "block"
      messageDiv.style.color = "green"
      messageDiv.textContent = "✓ " + data.message
      document.getElementById("addStudentForm").reset()
    } else {
      messageDiv.style.display = "block"
      messageDiv.style.color = "red"
      messageDiv.textContent = "✗ " + (data.error || "Error adding student")
    }
  } catch (err) {
    console.error(err)
    messageDiv.style.display = "block"
    messageDiv.style.color = "red"
    messageDiv.textContent = "✗ Network error"
  }
})
</script>

<section style="margin-bottom: 1.5rem;">
  <h2>Lesson Plans (Pending Approval)</h2>

  <% if (lessonPlans && lessonPlans.length > 0) { %>
    <table border="1" cellpadding="6" cellspacing="0">
      <thead>
        <tr>
          <th>Title</th>
          <th>Subject</th>
          <th>Class</th>
          <th>Term</th>
          <th>File</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% lessonPlans.forEach(plan => { %>
          <tr>
            <td><%= plan.title || "Untitled lesson" %></td>
            <td><%= plan.subject || "N/A" %></td>
            <td><%= plan.class_name || plan.class || "N/A" %></td>
            <td><%= plan.term || "N/A" %></td>
            <td>
              <% if (plan.file_path) { %>
                <a href="<%= plan.file_path %>" target="_blank" rel="noopener">Open</a>
              <% } else { %>
                —
              <% } %>
            </td>
            <td>
              <% if (plan.status === "pending") { %>
                <form action="/admin/update-lesson-status" method="POST" style="display:inline;">
                  <input type="hidden" name="lessonId" value="<%= plan.id %>">
                  <input type="hidden" name="status" value="approved">
                  <button type="submit">Approve</button>
                </form>
                <form action="/admin/update-lesson-status" method="POST" style="display:inline;">
                  <input type="hidden" name="lessonId" value="<%= plan.id %>">
                  <input type="hidden" name="status" value="rejected">
                  <button type="submit">Reject</button>
                </form>
              <% } else { %>
                <strong><%= plan.status || "Pending" %></strong>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No lesson plans available</p>
  <% } %>
</section>

<div class="admin-chart-attendance-grid">
  <section class="admin-card">
    <h2>School Overview</h2>
    <canvas id="analyticsChart"></canvas>
  </section>

  <section class="admin-card">
    <h2>Attendance</h2>
  <label for="attendanceDate">Select date</label>
  <input type="date" id="attendanceDate">

  <table border="1" cellpadding="6" cellspacing="0" style="margin-top: 0.75rem;">
    <thead>
      <tr>
        <th>Staff</th>
        <th>Action</th>
        <th>Date</th>
        <th>Time</th>
      </tr>
    </thead>
    <tbody id="attendanceTable">
      <tr><td colspan="4">Loading attendance…</td></tr>
    </tbody>
  </table>
</section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
async function loadAnalytics() {
  const chartCanvas = document.getElementById("analyticsChart")
  if (!chartCanvas) return

  try {
    const res = await fetch("/admin/analytics", { credentials: "same-origin" })
    if (!res.ok) throw new Error("Analytics unavailable")

    const data = await res.json()

    if (window.Chart) {
      new Chart(chartCanvas.getContext("2d"), {
        type: "bar",
        data: {
          labels: ["Students", "Staff", "Attendance Today", "Pending Lessons"],
          datasets: [{
            label: "School Stats",
            data: [
              data.students || 0,
              data.staff || 0,
              data.attendance || 0,
              data.pendingLessons || 0
            ]
          }]
        }
      })
    } else {
      chartCanvas.innerHTML = "<p>Chart library unavailable.</p>"
    }
  } catch (err) {
    console.error(err)
    chartCanvas.innerHTML = "<p>Analytics unavailable right now.</p>"
  }
}

async function loadAttendance() {
  const dateInput = document.getElementById("attendanceDate")
  const table = document.getElementById("attendanceTable")
  if (!dateInput || !table) return

  const date = dateInput.value || new Date().toISOString().split("T")[0]
  table.innerHTML = '<tr><td colspan="4">Loading attendance…</td></tr>'

  try {
    const res = await fetch(`/attendance?date=${encodeURIComponent(date)}`, { credentials: "same-origin" })
    if (!res.ok) throw new Error("Attendance unavailable")

    const data = await res.json()

    if (!data || data.length === 0) {
      table.innerHTML = '<tr><td colspan="4">No attendance records found.</td></tr>'
      return
    }

    table.innerHTML = data.map((entry) => `
      <tr>
        <td>${entry.staff_name || "Unknown staff"}</td>
        <td>${entry.action || "—"}</td>
        <td>${entry.date || "—"}</td>
        <td>${entry.time || "—"}</td>
      </tr>
    `).join("")
  } catch (err) {
    console.error(err)
    table.innerHTML = '<tr><td colspan="4">Attendance could not be loaded.</td></tr>'
  }
}

document.addEventListener("DOMContentLoaded", () => {
  const dateInput = document.getElementById("attendanceDate")
  if (dateInput) {
    dateInput.value = new Date().toISOString().split("T")[0]
    dateInput.addEventListener("change", loadAttendance)
  }

  loadAnalytics()
  loadAttendance()
})
</script>