<style>
  .admin-dashboard-layout {
    display: grid;
    grid-template-columns: minmax(220px, 260px) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    width: 100%;
  }

  .admin-sidebar-shell {
    position: sticky;
    top: 1rem;
    align-self: start;
  }

  .admin-dashboard-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .admin-dashboard-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 1.5rem 1.5rem 1.25rem;
    background: linear-gradient(135deg, #fff7f7 0%, #ffffff 100%);
  }

  .admin-dashboard-header h1 {
    margin: 0;
    font-size: 2rem;
    color: #800000;
  }

  .admin-dashboard-header p {
    margin: 0.25rem 0 0;
    color: #475569;
  }

  .admin-dashboard-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .admin-dashboard-actions a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: #eff6ff;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .admin-dashboard-actions a:hover {
    background: #dbeafe;
    color: #1d4ed8;
  }

  .admin-card {
    padding: 1.25rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.95rem;
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
  }

  .admin-section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .admin-section-header h2 {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
    color: #800000;
  }

  .admin-section-header p {
    margin: 0;
    color: #64748b;
    font-size: 0.95rem;
  }

  .admin-chart-attendance-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    gap: 1.5rem;
  }

  .admin-table-wrap {
    overflow-x: auto;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }

  .admin-table th,
  .admin-table td {
    padding: 0.8rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
    font-size: 0.95rem;
  }

  .admin-table th {
    background: #f8fafc;
    color: #334155;
    font-weight: 700;
  }

  .admin-table tbody tr:nth-child(even) {
    background: #fcfdff;
  }

  .admin-action-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .admin-action-group form {
    display: inline-block;
  }

  .admin-action-group button,
  .admin-link-button {
    border: none;
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .admin-action-group .approve-btn {
    background: #dcfce7;
    color: #166534;
  }

  .admin-action-group .reject-btn {
    background: #fee2e2;
    color: #b91c1c;
  }

  .admin-status-pill {
    display: inline-block;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: #e2e8f0;
    color: #334155;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .admin-form-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.9rem;
  }

  .admin-label {
    font-weight: 600;
    color: #334155;
  }

  .admin-date-input {
    border: 1px solid #cbd5e1;
    border-radius: 0.6rem;
    padding: 0.55rem 0.75rem;
  }

  .admin-empty-state {
    margin: 0;
    padding: 1rem;
    border-radius: 0.75rem;
    background: #f8fafc;
    color: #64748b;
    text-align: center;
  }

  @media (max-width: 900px) {
    .admin-dashboard-layout {
      grid-template-columns: 1fr;
    }

    .admin-sidebar-shell {
      width: 100%;
      position: static;
    }

    .admin-chart-attendance-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .admin-dashboard-header {
      padding: 1.2rem;
    }

    .admin-dashboard-actions {
      width: 100%;
    }

    .admin-dashboard-actions a {
      flex: 1;
      text-align: center;
    }
  }
</style>

<div class="admin-dashboard-layout">
  <div class="admin-sidebar-shell">
    <%- include("../partials/admin-sidebar") %>
  </div>
  <div class="admin-dashboard-main">
    <div class="admin-dashboard-header admin-card">
      <div>
        <h1>Admin Dashboard</h1>
        <p>Welcome <%= user.name %></p>
        <p>Role: <%= user.role %></p>
      </div>
      <div class="admin-dashboard-actions">
        <a href="/admin/dashboard">Refresh dashboard</a>
        <a href="/dashboard">Go to main dashboard</a>
      </div>
    </div>

<script>
const addStudentForm = document.getElementById("addStudentForm")

if (addStudentForm) {
  addStudentForm.addEventListener("submit", async (e) => {
    e.preventDefault()

    const name = document.getElementById("name").value
    const email = document.getElementById("email").value
    const password = document.getElementById("password").value
    const messageDiv = document.getElementById("addStudentMessage")

    try {
      const res = await fetch("/admin/add-student", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({ name, email, password })
      })

      const data = await res.json()

      if (res.ok) {
        messageDiv.style.display = "block"
        messageDiv.style.color = "green"
        messageDiv.textContent = "✓ " + data.message
        addStudentForm.reset()
      } else {
        messageDiv.style.display = "block"
        messageDiv.style.color = "red"
        messageDiv.textContent = "✗ " + (data.error || "Error adding student")
      }
    } catch (err) {
      console.error(err)
      messageDiv.style.display = "block"
      messageDiv.style.color = "red"
      messageDiv.textContent = "✗ Network error"
    }
  })
}
</script>

<section class="admin-card">
  <div class="admin-section-header">
    <div>
      <h2>Lesson Plans (Pending Approval)</h2>
      <p>Review and approve lesson submissions from staff.</p>
    </div>
  </div>

  <% if (lessonPlans && lessonPlans.length > 0) { %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Subject</th>
            <th>Class</th>
            <th>Term</th>
            <th>File</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% lessonPlans.forEach(plan => { %>
            <tr>
              <td><%= plan.title || "Untitled lesson" %></td>
              <td><%= plan.subject || "N/A" %></td>
              <td><%= plan.class_name || plan.class || "N/A" %></td>
              <td><%= plan.term || "N/A" %></td>
              <td>
                <% if (plan.file_path) { %>
                  <a href="<%= plan.file_path %>" target="_blank" rel="noopener">Open</a>
                <% } else { %>
                  —
                <% } %>
              </td>
              <td>
                <% if (plan.status === "pending") { %>
                  <div class="admin-action-group">
                    <form action="/admin/update-lesson-status" method="POST">
                      <input type="hidden" name="lessonId" value="<%= plan.id %>">
                      <input type="hidden" name="status" value="approved">
                      <button class="approve-btn" type="submit">Approve</button>
                    </form>
                    <form action="/admin/update-lesson-status" method="POST">
                      <input type="hidden" name="lessonId" value="<%= plan.id %>">
                      <input type="hidden" name="status" value="rejected">
                      <button class="reject-btn" type="submit">Reject</button>
                    </form>
                  </div>
                <% } else { %>
                  <span class="admin-status-pill"><%= plan.status || "Pending" %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="admin-empty-state">No lesson plans available.</p>
  <% } %>
</section>

<div class="admin-chart-attendance-grid">
  <section class="admin-card">
    <div class="admin-section-header">
      <div>
        <h2>School Overview</h2>
        <p>Visual snapshot of the current school statistics.</p>
      </div>
    </div>
    <canvas id="analyticsChart"></canvas>
  </section>

  <section class="admin-card">
    <div class="admin-section-header">
      <div>
        <h2>Attendance</h2>
        <p>Review staff attendance activity for a selected day.</p>
      </div>
    </div>
    <div class="admin-form-row">
      <label class="admin-label" for="attendanceDate">Select date</label>
      <input class="admin-date-input" type="date" id="attendanceDate">
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Staff</th>
            <th>Action</th>
            <th>Date</th>
            <th>Time</th>
          </tr>
        </thead>
        <tbody id="attendanceTable">
          <tr><td colspan="4">Loading attendance…</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
async function loadAnalytics() {
  const chartCanvas = document.getElementById("analyticsChart")
  if (!chartCanvas) return

  try {
    const res = await fetch("/admin/analytics", { credentials: "same-origin" })
    if (!res.ok) throw new Error("Analytics unavailable")

    const data = await res.json()

    if (window.Chart) {
      new Chart(chartCanvas.getContext("2d"), {
        type: "bar",
        data: {
          labels: ["Students", "Staff", "Attendance Today", "Pending Lessons"],
          datasets: [{
            label: "School Stats",
            data: [
              data.students || 0,
              data.staff || 0,
              data.attendance || 0,
              data.pendingLessons || 0
            ]
          }]
        }
      })
    } else {
      chartCanvas.innerHTML = "<p>Chart library unavailable.</p>"
    }
  } catch (err) {
    console.error(err)
    chartCanvas.innerHTML = "<p>Analytics unavailable right now.</p>"
  }
}

async function loadAttendance() {
  const dateInput = document.getElementById("attendanceDate")
  const table = document.getElementById("attendanceTable")
  if (!dateInput || !table) return

  const date = dateInput.value || new Date().toISOString().split("T")[0]
  table.innerHTML = '<tr><td colspan="4">Loading attendance…</td></tr>'

  try {
    const res = await fetch(`/attendance?date=${encodeURIComponent(date)}`, { credentials: "same-origin" })
    if (!res.ok) throw new Error("Attendance unavailable")

    const data = await res.json()

    if (!data || data.length === 0) {
      table.innerHTML = '<tr><td colspan="4">No attendance records found.</td></tr>'
      return
    }

    table.innerHTML = data.map((entry) => `
      <tr>
        <td>${entry.staff_name || "Unknown staff"}</td>
        <td>${entry.action || "—"}</td>
        <td>${entry.date || "—"}</td>
        <td>${entry.time || "—"}</td>
      </tr>
    `).join("")
  } catch (err) {
    console.error(err)
    table.innerHTML = '<tr><td colspan="4">Attendance could not be loaded.</td></tr>'
  }
}

document.addEventListener("DOMContentLoaded", () => {
  const dateInput = document.getElementById("attendanceDate")
  if (dateInput) {
    dateInput.value = new Date().toISOString().split("T")[0]
    dateInput.addEventListener("change", loadAttendance)
  }

  loadAnalytics()
  loadAttendance()
})
</script>