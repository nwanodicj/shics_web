<div style="display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: flex-start;">
  <%- include("../partials/admin-sidebar") %>
  <div style="flex: 1; min-width: 320px;">
    <h1>Lesson Plan Approval</h1>

    <section style="padding:1rem; border:1px solid #ddd; border-radius:6px; background:#fff;">
      <h2>Pending Lesson Plans</h2>
      <% if (lessonPlans && lessonPlans.length > 0) { %>
        <table border="1" cellpadding="8" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
          <thead>
            <tr>
              <th style="background: #f3f4f6;">Title</th>
              <th style="background: #f3f4f6;">Subject</th>
              <th style="background: #f3f4f6;">Class</th>
              <th style="background: #f3f4f6;">Submitted</th>
              <th style="background: #f3f4f6;">Status</th>
            </tr>
          </thead>
          <tbody>
            <% lessonPlans.forEach(plan => { %>
              <tr>
                <td><%= plan.title || 'Untitled' %></td>
                <td><%= plan.subject || 'N/A' %></td>
                <td><%= plan.class || plan.class_name || 'N/A' %></td>
                <td><%= plan.created_at ? new Date(plan.created_at).toLocaleDateString() : 'N/A' %></td>
                <td>
                  <% if (plan.status === 'pending') { %>
                    <form action="/admin/update-lesson-status" method="POST" style="display:inline; margin-right: 0.5rem;">
                      <input type="hidden" name="lessonId" value="<%= plan.id %>">
                      <input type="hidden" name="status" value="approved">
                      <button type="submit" style="padding: 0.4rem 0.8rem; border:none; border-radius:4px; background:#16a34a; color:#fff; cursor:pointer;">Approve</button>
                    </form>
                    <form action="/admin/update-lesson-status" method="POST" style="display:inline;">
                      <input type="hidden" name="lessonId" value="<%= plan.id %>">
                      <input type="hidden" name="status" value="rejected">
                      <button type="submit" style="padding: 0.4rem 0.8rem; border:none; border-radius:4px; background:#dc2626; color:#fff; cursor:pointer;">Reject</button>
                    </form>
                  <% } else { %>
                    <strong><%= plan.status %></strong>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p style="margin-top: 1rem;">No lesson plans are available at the moment.</p>
      <% } %>
    </section>
  </div>
</div>
