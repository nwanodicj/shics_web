<%# AUTO-COMMENT: File Overview - views/dashboard/admin-results.ejs | Purpose: View template: server-rendered UI markup and bindings. %>
<div class="admin-page-shell">
  <%- include("../partials/admin-sidebar") %>
  <div class="admin-page-main">
    <h1 class="admin-page-title">Results Management</h1>

    <section class="admin-card">
      <h2>Add New Result</h2>
      <p class="admin-empty-state">Use this form to save draft scores. Nothing is visible to students or parents until it is published below.</p>
      <form action="/admin/add-result" method="POST" class="admin-form-grid">
        <label class="admin-label">
          Student
          <select name="student_id" required class="admin-form-control">
            <option value="">Select a student</option>
            <% students.forEach(student => { %>
              <option value="<%= student.id %>"><%= student.name %></option>
            <% }) %>
          </select>
        </label>

        <input type="text" name="subject" placeholder="Subject" required class="admin-form-control">
        <input type="number" name="score" placeholder="Score" min="0" max="100" required class="admin-form-control">
        <input type="text" name="term" placeholder="Term (e.g. Term 1)" required class="admin-form-control">
        <button type="submit" class="admin-submit-btn">Save Result</button>
      </form>
    </section>

    <section class="admin-card">
      <h2>Publish Result</h2>
      <div class="admin-form-grid">
        <form action="/admin/publish-results" method="POST" class="admin-form-grid">
          <input type="hidden" name="scope" value="single">
          <label class="admin-label">
            Student
            <select name="student_id" required class="admin-form-control">
              <option value="">Select a student</option>
              <% students.forEach(student => { %>
                <option value="<%= student.id %>"><%= student.name %></option>
              <% }) %>
            </select>
          </label>

          <label class="admin-label">
            Term
            <input type="text" name="term" list="result-terms" placeholder="Term (e.g. Term 1)" required class="admin-form-control">
          </label>

          <button type="submit" class="admin-submit-btn">Publish Single Student</button>
        </form>

        <form action="/admin/publish-results" method="POST" class="admin-form-grid">
          <input type="hidden" name="scope" value="all">
          <label class="admin-label">
            Term
            <input type="text" name="term" list="result-terms" placeholder="Term (e.g. Term 1)" required class="admin-form-control">
          </label>

          <button type="submit" class="admin-submit-btn">Publish All Students</button>
        </form>
      </div>

      <datalist id="result-terms">
        <% if (terms && terms.length > 0) { %>
          <% terms.forEach(term => { %>
            <option value="<%= term %>"></option>
          <% }) %>
        <% } %>
      </datalist>
    </section>

    <section class="admin-card">
      <h2>Recent Results</h2>
      <% if (results && results.length > 0) { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Student</th>
              <th>Subject</th>
              <th>Score</th>
              <th>Term</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% results.forEach(result => { %>
              <tr>
                <td><%= result.student_name %></td>
                <td><%= result.subject %></td>
                <td><%= result.score %></td>
                <td><%= result.term %></td>
                <td><%= result.created_at ? new Date(result.created_at).toLocaleString() : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="admin-empty-state">No results have been recorded yet.</p>
      <% } %>
    </section>

    <section class="admin-card">
      <h2>Published Report Cards</h2>
      <% if (publishedCards && publishedCards.length > 0) { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Student</th>
              <th>Term</th>
              <th>Total</th>
              <th>Average</th>
              <th>Remark</th>
              <th>Published</th>
            </tr>
          </thead>
          <tbody>
            <% publishedCards.forEach(card => { %>
              <tr>
                <td><%= card.student_name %></td>
                <td><%= card.term %></td>
                <td><%= Number(card.total_score).toFixed(2) %></td>
                <td><%= Number(card.average_score).toFixed(2) %></td>
                <td><%= card.remark %></td>
                <td><%= card.published_at ? new Date(card.published_at).toLocaleString() : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="admin-empty-state">No report cards have been published yet.</p>
      <% } %>
    </section>
  </div>
</div>
