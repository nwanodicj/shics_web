<style>
  .admin-gallery-layout {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .admin-gallery-main {
    flex: 1;
    min-width: 320px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .admin-card {
    padding: 1.25rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .gallery-card {
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #f8fafc;
  }

  .gallery-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }

  .gallery-card-body {
    padding: 1rem;
  }

  .gallery-card-body h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .gallery-card-body p {
    margin: 0;
    color: #475569;
  }

  .gallery-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .gallery-actions form {
    margin: 0;
  }
</style>

<div class="admin-gallery-layout">
  <%- include("../partials/admin-sidebar") %>

  <div class="admin-gallery-main">
    <section class="admin-card">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <div>
          <h1>Gallery Management</h1>
          <p>Upload, preview, and remove images shown on the public gallery page.</p>
        </div>
      </div>
    </section>

    <section class="admin-card">
      <h2>Add Gallery Image</h2>
      <form action="/admin/add-gallery-image" method="POST" enctype="multipart/form-data">
        <div style="display: grid; gap: 0.75rem;">
          <label>
            Name
            <input type="text" name="name" required placeholder="Image title" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem;">
          </label>
          <label>
            Description
            <textarea name="description" required placeholder="Image description" rows="3" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem;"></textarea>
          </label>
          <label>
            Image File
            <input type="file" name="image" accept="image/*" required style="width: 100%;">
          </label>
          <button type="submit" style="padding: 0.85rem 1.25rem; background: #2563eb; border: none; color: #ffffff; border-radius: 0.5rem; cursor: pointer;">Upload Image</button>
        </div>
      </form>
    </section>

    <section class="admin-card">
      <h2>Existing Gallery Images</h2>

      <% if (galleryImages && galleryImages.length > 0) { %>
        <div class="gallery-grid">
          <% galleryImages.forEach(function(image) { %>
            <div class="gallery-card">
              <img src="<%= image.image_url %>" alt="<%= image.name %>">
              <div class="gallery-card-body">
                <h3><%= image.name %></h3>
                <p><%= image.description %></p>
                <div class="gallery-actions">
                  <form action="/admin/delete-gallery-image/<%= image.id %>" method="GET">
                    <button type="submit" style="padding: 0.55rem 0.9rem; background: #ef4444; color: #ffffff; border: none; border-radius: 0.5rem; cursor: pointer;">Delete</button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p>No gallery images have been uploaded yet.</p>
      <% } %>
    </section>
  </div>
</div>
