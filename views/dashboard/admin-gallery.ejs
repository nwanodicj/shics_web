<div class="admin-gallery-layout">
  <%- include("../partials/admin-sidebar") %>

  <div class="admin-gallery-main">
    <section class="admin-card">
      <div class="admin-card-header">
        <div>
          <h1>Gallery Management</h1>
          <p>Upload, preview, and remove images shown on the public gallery page.</p>
        </div>
      </div>
    </section>

    <section class="admin-card">
      <h2>Add Gallery Image</h2>
      <form action="/admin/add-gallery-image" method="POST" enctype="multipart/form-data" class="admin-form-grid">
        <label>
          Name
          <input type="text" name="name" required placeholder="Image title" class="admin-form-control">
        </label>
        <label>
          Description
          <textarea name="description" required placeholder="Image description" rows="3" class="admin-form-control"></textarea>
        </label>
        <label>
          Image File
          <input type="file" name="image" accept="image/*" required style="width: 100%;">
        </label>
        <button type="submit" class="admin-submit-btn">Upload Image</button>
      </form>
    </section>

    <section class="admin-card">
      <h2>Existing Gallery Images</h2>

      <% if (galleryImages && galleryImages.length > 0) { %>
        <div class="gallery-grid">
          <% galleryImages.forEach(function(image) { %>
            <div class="gallery-card">
              <img src="<%= image.image_url %>" alt="<%= image.name %>">
              <div class="gallery-card-body">
                <h3><%= image.name %></h3>
                <p><%= image.description %></p>
                <div class="gallery-actions">
                  <form action="/admin/delete-gallery-image/<%= image.id %>" method="GET">
                    <button type="submit" class="gallery-delete-btn">Delete</button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p>No gallery images have been uploaded yet.</p>
      <% } %>
    </section>
  </div>
</div>
