<%# AUTO-COMMENT: File Overview - views/dashboard/admin-students.ejs | Purpose: View template: server-rendered UI markup and bindings. %>
<div class="admin-page-shell">
  <%- include("../partials/admin-sidebar") %>
  <div class="admin-page-main">
    <h1 class="admin-page-title">Student Management</h1>
    <section class="admin-card">
      <h2>Add New Student</h2>
      <form id="addStudentForm">
        <div class="admin-form-grid">
          <input type="text" id="name" name="name" placeholder="Student Name" required class="admin-form-control">
          <input type="email" id="email" name="email" placeholder="Student Email" required class="admin-form-control">
          <input type="password" id="password" name="password" placeholder="Password" required class="admin-form-control">
          <button type="submit" class="admin-submit-btn">Add Student</button>
        </div>
      </form>
      <div id="addStudentMessage" class="admin-message"></div>
    </section>

    <section class="admin-card">
      <h2>Registered Students</h2>
      <% if (students && students.length > 0) { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Created</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach(student => { %>
              <tr>
                <td><%= student.name %></td>
                <td><%= student.email %></td>
                <td><%= new Date(student.created_at).toLocaleDateString() %></td>
                <td>
                  <form action="/admin/delete-student/<%= student.id %>" method="GET" onsubmit="return confirm('Remove this student?');">
                    <button type="submit" class="admin-remove-btn">Remove</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="admin-empty-state">No students are registered yet.</p>
      <% } %>
    </section>
  </div>
</div>

<script>
  document.getElementById("addStudentForm").addEventListener("submit", async (e) => {
    e.preventDefault()
    const name = document.getElementById("name").value
    const email = document.getElementById("email").value
    const password = document.getElementById("password").value
    const messageDiv = document.getElementById("addStudentMessage")

    try {
      const res = await fetch("/admin/add-student", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, password })
      })
      const data = await res.json()
      messageDiv.style.display = "block"
      if (res.ok) {
        messageDiv.style.color = "#166534"
        messageDiv.textContent = "✓ Student added successfully. Refresh the page to view the updated list."
        document.getElementById("addStudentForm").reset()
      } else {
        messageDiv.style.color = "#991b1b"
        messageDiv.textContent = data.error || "Error adding student"
      }
    } catch (err) {
      messageDiv.style.display = "block"
      messageDiv.style.color = "#991b1b"
      messageDiv.textContent = "Network error while adding student"
    }
  })
</script>
