<div class="admin-page-shell">
  <%- include("../partials/admin-sidebar") %>
  <div class="admin-page-main">
    <h1 class="admin-page-title">Parent Management</h1>

    <section class="admin-card">
      <h2>Link Parent to Student</h2>
      <form action="/admin/link-parent" method="POST" class="admin-form-grid">
        <label class="admin-label">
          Parent
          <select name="parent_id" required class="admin-form-control">
            <option value="">Select a parent</option>
            <% parents.forEach(parent => { %>
              <option value="<%= parent.id %>"><%= parent.name %> — <%= parent.email %></option>
            <% }) %>
          </select>
        </label>
        <label class="admin-label">
          Student
          <select name="student_id" required class="admin-form-control">
            <option value="">Select a student</option>
            <% students.forEach(student => { %>
              <option value="<%= student.id %>"><%= student.name %> — <%= student.email %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit" class="admin-submit-btn">Link Parent and Student</button>
      </form>
    </section>

    <section class="admin-card">
      <h2>Parent-Student Assignments</h2>
      <% if (parentLinks && parentLinks.length > 0) { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Parent</th>
              <th>Student</th>
            </tr>
          </thead>
          <tbody>
            <% parentLinks.forEach(link => { %>
              <tr>
                <td><%= link.parent_name %></td>
                <td><%= link.student_name %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="admin-empty-state">No parent-student assignments have been created yet.</p>
      <% } %>
    </section>
  </div>
</div>
