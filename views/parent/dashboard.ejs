<h1>Parent Dashboard</h1>

<h2>Your Children</h2>

<ul>
  <% children.forEach(child => { %>
    <li><strong><%= child.name %></strong></li>
  <% }) %>
</ul>

<hr>

<h2>Published Report Cards</h2>

<% if (results.length > 0) { %>
  <ul>
    <% results.forEach(card => { %>
      <li>
        <strong><%= card.student.name %></strong> -
        <%= card.publication.term %>,
        Average: <%= Number(card.publication.average_score).toFixed(2) %>,
        Remark: <%= card.publication.remark %>
        <ul>
          <% card.subjects.forEach(subject => { %>
            <li><%= subject.subject %>: <%= subject.score %> (<%= subject.grade %>)</li>
          <% }) %>
        </ul>
        <a href="/parent/download-report/<%= card.student.id %>?term=<%= encodeURIComponent(card.publication.term) %>" target="_blank" rel="noopener">Download</a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No published report cards available</p>
<% } %>