<%# AUTO-COMMENT: File Overview - views/pages/gallery.ejs | Purpose: View template: server-rendered UI markup and bindings. %>
<!-- Gallery Page -->
<h1>Our Gallery</h1>
<a href="/about"><button>Back</button></a>
<div class="main-gallery">
  <div class="gallery-container">
    <% if (galleryImages && galleryImages.length > 0) { %>
      <% galleryImages.forEach(function(image) { %>
        <figure class="card">
          <img class="card-img" src="<%= image.image_url %>" alt="<%= image.name %>" loading="lazy">
          <figcaption class="name"><%= image.name %></figcaption>
          <p class="description"><%= image.description %></p>
        </figure>
      <% }) %>
    <% } else { %>
      <p>No gallery images available yet.</p>
    <% } %>
  </div>
</div>