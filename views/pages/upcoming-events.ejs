<style>
  .upcoming-page {
    max-width: 1080px;
    margin: 2rem auto;
    padding: 0 1rem;
    color: #1f2937;
  }

  .upcoming-page h1 {
    font-size: 2.6rem;
    margin-bottom: 0.75rem;
  }

  .upcoming-page p {
    line-height: 1.75;
    margin-bottom: 1.25rem;
    color: #475569;
  }

  .events-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  .event-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
  }

  .event-card img {
    width: 100%;
    max-height: 260px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 0.9rem;
    border: 1px solid #e2e8f0;
  }

  .event-card h2 {
    margin-top: 0;
    color: #0f172a;
  }

  .event-card time {
    display: block;
    margin-bottom: 0.75rem;
    color: #2563eb;
    font-weight: 700;
  }

  .event-card p {
    margin-bottom: 0;
    color: #475569;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  @media (max-width: 900px) {
    .events-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="upcoming-page">
  <h1>Upcoming Events</h1>
  <p>Keep up with our most important school events. These dates help families plan for assemblies, sports activities, and opportunities to engage with the school community.</p>

  <div class="events-grid">
    <% if (upcomingEvents && upcomingEvents.length > 0) { %>
      <% upcomingEvents.forEach(event => { %>
        <article class="event-card">
          <% if (event.image_url) { %>
            <img src="<%= event.image_url %>" alt="<%= event.title %>" loading="lazy">
          <% } %>
          <time><%= event.event_date ? new Date(event.event_date).toDateString() : "Date not set" %></time>
          <h2><%= event.title %></h2>
          <p><%= event.description %></p>
        </article>
      <% }) %>
    <% } else { %>
      <article class="event-card">
        <h2>No upcoming events yet</h2>
        <p>The admin team has not posted upcoming events yet. Please check back soon.</p>
      </article>
    <% } %>
  </div>
</div>